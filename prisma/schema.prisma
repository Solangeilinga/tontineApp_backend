// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connexion "pooler" (PgBouncer, port 6543) — utilisée par l'appli à
  // l'exécution pour les requêtes normales. Recommandé par Supabase pour
  // limiter le nombre de connexions Postgres ouvertes simultanément.
  url       = env("DATABASE_URL")
  // Connexion DIRECTE (port 5432, sans PgBouncer) — utilisée UNIQUEMENT par
  // le CLI Prisma pour `db push` / `migrate`. Le pooler en mode transaction
  // ne supporte pas les verrous consultatifs (advisory locks) et certaines
  // opérations DDL dont Prisma a besoin pour créer/modifier des tables —
  // sans ça, `db push` peut tourner plusieurs minutes puis échouer
  // silencieusement, exactement comme observé en production.
  directUrl = env("DIRECT_URL")
}

// ─── TENANTS (Gérants) ─────────────────────────────────────────────────────
model Tenant {
  id         String   @id @default(uuid())
  name       String
  phone      String   @unique
  photoUrl   String?  @map("photo_url")
  pinHash    String?  @map("pin_hash")
  fcmToken   String?  @map("fcm_token")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  groups        Group[]
  users         User[]
  notifications Notification[]
  subscription  Subscription?

  @@map("tenants")
}

// ─── USERS (Membres des tontines) ──────────────────────────────────────────
model User {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  phone      String
  photoUrl   String?  @map("photo_url")
  fcmToken   String?  @map("fcm_token")
  pinHash    String?  @map("pin_hash")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  groupMembers  GroupMember[]
  contributions Contribution[]
  turns         Turn[]
  notifications Notification[]

  @@unique([tenantId, phone])
  @@map("users")
}

// ─── GROUPS (Groupes de tontine) ───────────────────────────────────────────
model Group {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  name           String
  type           ContributionType
  frequencyValue Int              @default(1) @map("frequency_value")
  frequencyUnit  FrequencyUnit    @default(MONTHS) @map("frequency_unit")
  amount         Float
  currency       String           @default("XOF")
  description    String?
  inviteCode     String           @unique @map("invite_code")
  maxMembers     Int?             @map("max_members")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  groupMembers  GroupMember[]
  contributions Contribution[]
  turns         Turn[]
  cycles        Cycle[]

  @@map("groups")
}

// ─── GROUP_MEMBERS ─────────────────────────────────────────────────────────
model GroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  orderTurn Int      @map("order_turn")
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@unique([groupId, orderTurn])
  @@map("group_members")
}

// ─── CYCLES (Tours de rotation complets) ──────────────────────────────────
// Un cycle = un tour de rotation complet du groupe : chaque membre reçoit
// sa mise une fois (dans l'ordre de orderTurn), selon un calendrier calculé
// à l'avance à partir de startDate + fréquence du groupe. Une fois tous les
// membres servis, le gérant clôture le cycle et un nouveau cycle démarre.
model Cycle {
  id          String      @id @default(uuid())
  groupId     String      @map("group_id")
  cycleNumber Int         @map("cycle_number")
  status      CycleStatus @default(ACTIVE)
  startDate   DateTime    @map("start_date")
  dueDate     DateTime?   @map("due_date")
  endDate     DateTime?   @map("end_date")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  group         Group          @relation(fields: [groupId], references: [id])
  contributions Contribution[]
  turns         Turn[]

  @@unique([groupId, cycleNumber])
  @@map("cycles")
}

// ─── CONTRIBUTIONS ─────────────────────────────────────────────────────────
model Contribution {
  id              String             @id @default(uuid())
  groupId         String             @map("group_id")
  userId          String             @map("user_id")
  cycleId         String             @map("cycle_id")
  roundNumber     Int                @map("round_number")
  status          ContributionStatus @default(PENDING)
  amount          Float
  dueDate         DateTime           @map("due_date")
  paidDate        DateTime?          @map("paid_date")
  note            String?
  // Masque cette cotisation dans l'historique personnel du membre
  // uniquement. N'affecte JAMAIS les vues du gérant (liste, récap de
  // cycle) — la donnée financière réelle reste intacte et comptée.
  hiddenForMember Boolean            @default(false) @map("hidden_for_member")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relations
  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@map("contributions")
}

// ─── TURNS ─────────────────────────────────────────────────────────────────
model Turn {
  id            String     @id @default(uuid())
  groupId       String     @map("group_id")
  userId        String     @map("user_id")
  cycleId       String     @map("cycle_id")
  turnNumber    Int        @map("turn_number")
  scheduledDate DateTime   @map("scheduled_date")
  status        TurnStatus @default(UPCOMING)
  // Empêche de renvoyer le rappel de retard chaque jour indéfiniment —
  // le rappel n'est envoyé qu'une seule fois par tour.
  overdueReminderSentAt DateTime? @map("overdue_reminder_sent_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  // Relations
  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@unique([cycleId, turnNumber])
  @@map("turns")
}

// ─── NOTIFICATIONS ─────────────────────────────────────────────────────────
model Notification {
  id       String           @id @default(uuid())
  tenantId String           @map("tenant_id")
  userId   String           @map("user_id")
  type     NotificationType
  title    String
  message  String
  data     Json?
  isRead   Boolean          @default(false) @map("is_read")
  isDeleted Boolean         @default(false) @map("is_deleted")
  sentAt   DateTime         @default(now()) @map("sent_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─── AUDIT LOG ─────────────────────────────────────────────────────────────
// Historique immuable des actions effectuées dans un groupe. Volontairement
// SANS relation de clé étrangère (autre que tenantId pour le scoping) afin
// que l'historique survive même si le groupe, l'utilisateur ou l'entité
// concernée est supprimé par la suite — un journal d'audit doit rester
// consultable indépendamment du cycle de vie des données qu'il décrit.
model AuditLog {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  groupId     String?   @map("group_id")
  actorType   ActorType @map("actor_type")
  actorId     String    @map("actor_id")
  actorName   String    @map("actor_name")
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  metadata    Json?
  // Masque cette entrée dans le fil "Activités" (vue simplifiée et
  // supprimable). N'affecte JAMAIS le "Journal d'audit" complet, qui reste
  // toujours intégral et non-supprimable — c'est la source de preuve légale.
  isDismissed Boolean   @default(false) @map("is_dismissed")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, groupId])
  @@map("audit_logs")
}

// ─── SUBSCRIPTIONS (Abonnement du gérant / monétisation) ──────────────────
// Un seul abonnement par tenant. Le plan FREE n'a pas de currentPeriodEnd
// (accès permanent, mais limité fonctionnellement — voir middleware
// requireActiveSubscription). Les plans payants sont activés/prolongés par
// le webhook SebPay lorsqu'un Payment passe à APPROVED.
model Subscription {
  id               String       @id @default(uuid())
  tenantId         String       @unique @map("tenant_id")
  plan             SubPlan      @default(FREE)
  status           SubStatus    @default(ACTIVE)
  // Date de fin de la période payée en cours. Null pour le plan FREE.
  currentPeriodEnd DateTime?    @map("current_period_end")
  // Pour savoir si l'essai gratuit a déjà été consommé (une seule fois/tenant)
  trialUsedAt      DateTime?    @map("trial_used_at")
  // Empêche de renvoyer le rappel J-3 plusieurs fois pour la même période.
  // Remis à null à chaque renouvellement (voir subscriptionService.handleWebhookPayload).
  expiryReminderSentAt DateTime? @map("expiry_reminder_sent_at")
  // Relances périodiques "passez au plan supérieur" pour les comptes
  // restés en FREE — voir subscriptionService.sendUpgradeNudges.
  lastUpgradeNudgeSentAt DateTime? @map("last_upgrade_nudge_sent_at")
  upgradeNudgeCount      Int       @default(0) @map("upgrade_nudge_count")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

// ─── PAYMENTS (Transactions SebPay liées à un abonnement) ─────────────────
// Une ligne par TENTATIVE de collecte SebPay. external_reference est notre
// clé d'idempotence : générée par nous avant l'appel, elle sert à retrouver
// la transaction quand le webhook arrive (SebPay nous la renvoie telle quelle).
model Payment {
  id                  String        @id @default(uuid())
  subscriptionId      String        @map("subscription_id")
  tenantId            String        @map("tenant_id")
  plan                SubPlan       @map("plan")
  amount              Float
  currency            String        @default("XOF")
  operator             String?
  phone                String?
  country              String        @default("BJ")
  // Notre référence unique envoyée à SebPay (external_reference)
  externalReference   String        @unique @map("external_reference")
  // Identifiant renvoyé par SebPay (transaction_id) — rempli dès la réponse
  // initiale, confirmé/complété par le webhook.
  sebpayTransactionId String?       @map("sebpay_transaction_id")
  status              PaymentStatus @default(PENDING)
  // Snapshot du dernier payload webhook reçu, pour audit/debug.
  rawWebhookPayload   Json?         @map("raw_webhook_payload")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@map("payments")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────
enum ContributionType {
  MONEY
  PHONE
  CLOTHES
  APPLIANCE
  OTHER
}

enum FrequencyUnit {
  DAYS
  WEEKS
  MONTHS
}

enum ContributionStatus {
  PENDING
  RECEIVED
  LATE
}

enum TurnStatus {
  UPCOMING
  CURRENT
  DONE
}

enum CycleStatus {
  ACTIVE
  COMPLETED
}

enum ActorType {
  TENANT
  USER
}

enum NotificationType {
  REMINDER_J2
  REMINDER_J1
  YOUR_TURN
  CONTRIBUTION_CONFIRMED
  CONTRIBUTION_OVERDUE
  TURN_OVERDUE
  MEMBER_JOINED
  GENERAL
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
}

enum SubPlan {
  FREE
  STARTER
  PRO
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}