# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tontineapp?schema=public"
# Requis avec Supabase (ou tout Postgres derrière un pooler PgBouncer) :
# DATABASE_URL = connexion "pooler" (port 6543, ex: aws-0-xxx.pooler.supabase.com)
#   → utilisée par l'appli à l'exécution.
# DIRECT_URL   = connexion DIRECTE (port 5432, ex: db.<ref-projet>.supabase.co)
#   → utilisée UNIQUEMENT par `prisma db push`/`migrate` (le pooler ne
#   supporte pas les opérations DDL). Dans Supabase : Settings > Database >
#   Connection string > choisir "URI" (pas "Connection pooling").
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/tontineapp?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Redis (pour OTP et sessions)
REDIS_URL=redis://localhost:6379

# Africa's Talking (OTP SMS)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox  # Mettre votre username en production
AT_SENDER_ID=TontineApp

# Firebase (Notifications push FCM)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# SebPay (agrégateur Mobile Money — monétisation des abonnements)
# Sandbox par défaut : utiliser les clés pk_test_/sk_test_ tant que le KYC
# n'est pas approuvé. Ne JAMAIS committer de vraies clés live.
SEBPAY_BASE_URL=https://newapi.sebpay.bj/api/v1
SEBPAY_PUBLIC_KEY=pk_test_your_public_key
SEBPAY_SECRET_KEY=sk_test_your_secret_key
# URL absolue de la route webhook exposée publiquement (voir routes/subscriptions.js)
SEBPAY_CALLBACK_URL=https://your-backend-domain.com/api/subscriptions/webhook
